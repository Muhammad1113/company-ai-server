# HTTPS reverse proxy + static frontend.  Env: SITE_ADDRESS (default localhost), TLS_MODE (internal | you@email)
{$SITE_ADDRESS:localhost} {
	tls {$TLS_MODE:internal}

	# /metrics and docs are never public
	@private path /metrics* /docs* /redoc* /openapi.json
	respond @private 404

	request_body {
		max_size 25MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'"
		-Server
	}

	handle /api/* {
		# flush_interval -1: SSE tokens must not be buffered
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle /health {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		encode gzip
		try_files {path} /index.html
		file_server
	}
}

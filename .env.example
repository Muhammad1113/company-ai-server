# ===== Development (.env) =====  copy: cp .env.example .env
APP_ENV=development
LOG_LEVEL=INFO

# Local llama.cpp servers
LLAMA_BASE_URL=http://127.0.0.1:8081
LLAMA_MODEL=Qwen3.5-9B
RAG_EMBEDDER=llama_cpp
RAG_EMBED_BASE_URL=http://127.0.0.1:8082
RAG_EMBED_MODEL=embedding-model

# Storage (dev: JSON + SQLite).  Production: see .env.production.example
RAG_STORE_BACKEND=json
DATABASE_PATH=data/company_ai.db

# Frontend on another origin (npm run dev) only:
# CORS_ORIGINS=http://localhost:5173

# --- Baad mein vLLM par shift (infrastructure team): sirf ye 3 lines badlo, code nahi ---
# vLLM server: vllm serve <model> --served-model-name qwen-chat --port 8081   (compute capability 7.0+ GPU; GTX 1070 par nahi chalta)
# INFERENCE_PROVIDER=vllm
# LLAMA_BASE_URL=http://127.0.0.1:8081
# LLAMA_MODEL=qwen-chat            # = vLLM ka --served-model-name
# Embeddings alag setting hain (RAG_EMBED_BASE_URL); unko llama.cpp par chhor sakte ho. vLLM par embedding ke liye alag instance chahiye.

# Web search sends question text to external search engines. Default is OFF; production preflight errors if it is on.
WEB_SEARCH_ENABLED=false

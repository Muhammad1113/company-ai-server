# ===== Production (.env) =====   cp .env.production.example .env   ->  har <CHANGE_ME> badlo
# Phir:  python scripts/preflight.py   (koi [ERROR] nahi hona chahiye)

APP_ENV=production
LOG_LEVEL=INFO

# --- PostgreSQL + pgvector (users, sessions, conversations, regulatory, vectors, usage sab yahin) ---
# docker-compose.yml (production) DATABASE_URL khud set karta hai. Host par API chalao to ye line zaroori hai.
POSTGRES_PASSWORD=<CHANGE_ME_alphanumeric_only>
DATABASE_URL=postgresql://company_ai:<CHANGE_ME_alphanumeric_only>@127.0.0.1:5432/company_ai
RAG_STORE_BACKEND=pgvector
RAG_EMBED_DIM=1024

# --- llama.cpp (host par, GPU) ---
LLAMA_BASE_URL=http://127.0.0.1:8081
LLAMA_MODEL=Qwen3.5-9B
RAG_EMBEDDER=llama_cpp
RAG_EMBED_BASE_URL=http://127.0.0.1:8082
RAG_EMBED_MODEL=embedding-model
# Docker API container ke liye (llama host par): LLAMA_BASE_URL=http://host.docker.internal:8081 aur
# RAG_EMBED_BASE_URL=http://host.docker.internal:8082  (start_all.ps1 -LlamaHost 0.0.0.0 + scripts\lock_ports.ps1 -DockerMode)

# --- Security ---
WEB_SEARCH_ENABLED=false
METRICS_TOKEN=<CHANGE_ME_long_random_token>
SESSION_TTL_HOURS=24
RATE_LIMIT_PER_MINUTE=120
# Same-origin proxy (Caddy) ke saath CORS khali rakho. Kabhi '*' nahi.
CORS_ORIGINS=

# --- HTTPS (Caddy) ---
SITE_ADDRESS=ai.yourcompany.com
# internal = Caddy ki apni CA (har client par root cert trust karna parta hai); ya email do => Let's Encrypt (public DNS + 80/443 chahiye)
TLS_MODE=internal

# --- Regulatory sync ---
OPENFDA_API_KEY=
OPENFDA_AUTO_SYNC_HOURS=0

# --- Baad mein vLLM par shift (infrastructure team): sirf ye 3 lines badlo, code nahi ---
# vLLM server: vllm serve <model> --served-model-name qwen-chat --port 8081   (compute capability 7.0+ GPU; GTX 1070 par nahi chalta)
# INFERENCE_PROVIDER=vllm
# LLAMA_BASE_URL=http://127.0.0.1:8081
# LLAMA_MODEL=qwen-chat            # = vLLM ka --served-model-name
# Embeddings alag setting hain (RAG_EMBED_BASE_URL); unko llama.cpp par chhor sakte ho. vLLM par embedding ke liye alag instance chahiye.
